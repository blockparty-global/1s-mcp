{
  "name": "@one-source/docs-mcp",
  "version": "4.0.3",
  "type": "module",
  "description": "MCP server for OneSource Web3 API documentation — search docs, explore GraphQL schema, find examples",
  "bin": {
    "onesource-docs-mcp": "./dist/cli.js"
  },
  "main": "./dist/create-server.js",
  "types": "./dist/create-server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/create-server.d.ts",
      "default": "./dist/create-server.js"
    },
    "./tools/search-docs": {
      "types": "./dist/tools/search-docs.d.ts",
      "default": "./dist/tools/search-docs.js"
    },
    "./tools/get-query-reference": {
      "types": "./dist/tools/get-query-reference.d.ts",
      "default": "./dist/tools/get-query-reference.js"
    },
    "./tools/get-type-definition": {
      "types": "./dist/tools/get-type-definition.d.ts",
      "default": "./dist/tools/get-type-definition.js"
    },
    "./tools/list-examples": {
      "types": "./dist/tools/list-examples.d.ts",
      "default": "./dist/tools/list-examples.js"
    },
    "./tools/list-supported-chains": {
      "types": "./dist/tools/list-supported-chains.d.ts",
      "default": "./dist/tools/list-supported-chains.js"
    },
    "./tools/get-filter-reference": {
      "types": "./dist/tools/get-filter-reference.d.ts",
      "default": "./dist/tools/get-filter-reference.js"
    },
    "./tools/get-pagination-guide": {
      "types": "./dist/tools/get-pagination-guide.d.ts",
      "default": "./dist/tools/get-pagination-guide.js"
    },
    "./tools/get-schema-overview": {
      "types": "./dist/tools/get-schema-overview.d.ts",
      "default": "./dist/tools/get-schema-overview.js"
    },
    "./tools/get-authentication-guide": {
      "types": "./dist/tools/get-authentication-guide.d.ts",
      "default": "./dist/tools/get-authentication-guide.js"
    },
    "./tools/get-mcp-setup-guide": {
      "types": "./dist/tools/get-mcp-setup-guide.d.ts",
      "default": "./dist/tools/get-mcp-setup-guide.js"
    }
  },
  "files": [
    "dist/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onesource",
    "web3",
    "graphql",
    "blockchain",
    "documentation"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "node -e \"const fs=require('fs'),p=require('path');const d=p.join(__dirname,'data');if(!fs.existsSync(p.join(d,'schema-data.json'))||!fs.existsSync(p.join(d,'skills'))){console.error('ERROR: data/schema-data.json and data/skills/ must exist before publishing. Run npm run build:plugin from the repo root.');process.exit(1)}\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "BlockParty",
  "license": "MIT",
  "homepage": "https://docs.onesource.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlockPartyDev/1s-developer-docs.git",
    "directory": "scripts/mcp-server"
  }
}
