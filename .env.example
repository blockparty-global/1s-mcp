# Copy to .env and fill in values. Never commit .env.
ONESOURCE_JWT_SECRET=        # OAuth — 128 hex chars: openssl rand -hex 64 (server starts without it, OAuth endpoints disabled)
ONESOURCE_API_KEY=           # optional — enables authenticated mode; key from app.onesource.io
PORT=3000                    # optional — HTTP server port (default 3000)
